{
  "name": "meramonitor-mcp-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Remote MCP server exposing MeraMonitor screenshots, time tracker and time claim data",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node dist/dates.test.js",
    "dev": "tsc -p tsconfig.json && node dist/server.js",
    "start": "node dist/server.js",
    "inspect": "npx @modelcontextprotocol/inspector"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@upstash/redis": "1.34.3",
    "axios": "1.6.5",
    "express": "4.21.2",
    "jose": "5.9.6",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.16.0",
    "typescript": "5.6.3"
  }
}

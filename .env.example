# ---------------------------------------------------------------------------
# Which MeraMonitor backend the tools read from: dev | qa | production
# ---------------------------------------------------------------------------
MM_ENV=production

# ---------------------------------------------------------------------------
# The public HTTPS URL this server is reachable at. claude.ai connects here,
# and every OAuth endpoint is advertised relative to it, so it MUST EXACTLY
# EQUAL the final public domain - no trailing slash, no www mismatch. A
# mismatch breaks discovery in a way that is confusing to debug.
#
# On Vercel this is required for production deployments; preview deployments
# fall back to VERCEL_URL.
# ---------------------------------------------------------------------------
MCP_PUBLIC_URL=https://meramonitor-mcp.vercel.app

# Port the Node process listens on locally. Ignored on Vercel.
PORT=3001

# ---------------------------------------------------------------------------
# Authentication mode:
#   self-hosted  This server is its own OAuth 2.1 authorization server and
#                checks credentials against MeraMonitor's login. Default.
#   external     Tokens come from a third-party IdP, validated via JWKS.
#   none         No auth at all. Local testing only; refused on production.
# ---------------------------------------------------------------------------
MCP_AUTH_MODE=self-hosted

# Pre-fills the domain box on the sign-in form.
#
# This is the tenant's WHITE-LABEL HOST, not an email domain. The SPA derives it
# from window.location.hostname (with dev.mera.work as its localhost fallback),
# so it is whatever host people reach MeraMonitor on. Verified 2026-09-04:
# app.mera.work signs in, meramonitor.com is rejected.
MM_LOGIN_DOMAIN=app.mera.work

# How long an issued access token lives (seconds). Default 8 hours, minimum 300.
MCP_TOKEN_TTL_SECONDS=28800

# Hard cap on screenshot images returned by one get_screenshots call.
# Lowered from 10 to 4 for Vercel's 4.5 MB response limit; the response is
# additionally truncated at ~3.5 MB of image data with a note naming what was
# skipped.
MM_MAX_SCREENSHOTS_PER_CALL=4

# Axios timeout for MeraMonitor calls, in ms. MUST stay below the function
# maxDuration in vercel.json (60s) so a slow backend produces a readable tool
# error instead of a bare FUNCTION_INVOCATION_TIMEOUT.
MM_API_TIMEOUT_MS=25000

# ---------------------------------------------------------------------------
# Upstash Redis (Vercel Marketplace).
#
# Vercel KV is no longer a first-party product; storage comes from Marketplace
# providers. Add Upstash Redis under Project -> Storage -> Marketplace and these
# two are injected automatically. Do NOT use Vercel Global Config for this:
# its writes are documented as taking "seconds" to propagate, and an
# authorization code must be readable immediately after it is written.
#
# Required on Vercel. Omit them locally and the server falls back to an
# in-memory store plus MCP_CLIENTS_FILE, exactly as the pre-port build behaved.
# ---------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# SELF-HOSTED PATH ONLY. Unused on Vercel, whose filesystem is read-only and
# ephemeral - the client registry lives in Redis there instead.
#
# This MUST persist across restarts: if it is lost, every connector has to be
# re-added. Keep it OUTSIDE the folder you overwrite when pasting a new build.
# ---------------------------------------------------------------------------
MCP_CLIENTS_FILE=./data/oauth-clients.json

# ---------------------------------------------------------------------------
# MCP_AUTH_MODE=external only.
# ---------------------------------------------------------------------------
# OAUTH_ISSUER_URL=https://your-tenant.example.com
# OAUTH_JWKS_URL=https://your-tenant.example.com/.well-known/jwks.json
# OAUTH_AUTHORIZATION_ENDPOINT=https://your-tenant.example.com/oauth2/authorize
# OAUTH_TOKEN_ENDPOINT=https://your-tenant.example.com/oauth2/token
# OAUTH_REGISTRATION_ENDPOINT=https://your-tenant.example.com/oauth2/register
# OAUTH_AUDIENCE=meramonitor-mcp
# OAUTH_SCOPES=mcp

# ---------------------------------------------------------------------------
# MCP_AUTH_MODE=none only. The server signs in once at start-up with these and
# acts as that user for every request. Never set these on a deployed server.
# ---------------------------------------------------------------------------
# MM_DEV_EMAIL=
# MM_DEV_PASSWORD=

# ---------------------------------------------------------------------------
# Optional: PortalIntegrationApi machine-to-machine credentials, if the backend
# team supplies an X-Api-Key. Not required for the sign-in flow above.
# ---------------------------------------------------------------------------
# MM_PORTAL_API_KEY=
# MM_PORTAL_CLIENT_ID=
# MM_PORTAL_CLIENT_SECRET=
